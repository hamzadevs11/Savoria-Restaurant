# ============================================
# SAVORIA - Environment Variables
# Copy this to .env.local for development
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/savoria_db"

# JWT Secrets (generate strong random strings for production)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Savoria"

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# Email (Resend / SendGrid)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="hello@savoria.com"

# Stripe (optional - for production payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Anthropic AI (for chatbot)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# WebSockets (optional)
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Rate limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"
